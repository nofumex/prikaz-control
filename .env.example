# Separate Telegram bot for reports (do not reuse the customer bot token)
REPORT_TG_BOT_TOKEN=
# Telegram user/chat ID that receives the daily report and may use the bot
REPORT_CHAT_ID=

# Read-only source database used by prikaz-cancel-bot.
# Point to the same SQLite file (URL form: sqlite:///absolute/path/to/prikaz_bot.sqlite3)
SOURCE_DATABASE_URL=sqlite:///../prikaz-cancel-bot/data/prikaz_bot.sqlite3

# amoCRM read-only API credentials
AMOCRM_BASE_URL=
AMOCRM_ACCESS_TOKEN=
# Exact pipeline name used to select Судебный приказ leads
AMOCRM_PIPELINE_NAME=Судебный приказ
AMOCRM_MONITORING_SOURCE=Клиенты по судебному приказу

# IANA timezone; scheduler and report date boundaries use this timezone
TIMEZONE=Asia/Krasnoyarsk
DAILY_REPORT_TIME=09:00
REPORT_DATABASE_PATH=data/reporting.sqlite3
REPORT_PAGE_SIZE=5
